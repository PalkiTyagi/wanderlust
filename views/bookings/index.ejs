<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <h2>My Bookings</h2>

  <% if (bookings.length === 0) { %>
    <p>You have no bookings yet.</p>
  <% } %>

  <div class="row">
    <% bookings.forEach(booking => { %>
      <div class="col-md-6 mb-4">
        <div class="card h-100">
          <% if (booking.listing && booking.listing.image) { %>
            <img src="<%= booking.listing.image.url %>" class="card-img-top" alt="<%= booking.listing.title %>">
          <% } %>
          <div class="card-body">
            <h4><%= booking.listing ? booking.listing.title : "Property removed" %></h4>
            <% if (booking.listing) { %>
              <p><b>Location:</b> <%= booking.listing.location %>, <%= booking.listing.country %></p>
            <% } %>
            <p><b>Check In:</b> <%= booking.checkIn.toLocaleDateString() %></p>
            <p><b>Check Out:</b> <%= booking.checkOut.toLocaleDateString() %></p>
            <p><b>Guests:</b> <%= booking.guests %></p>
            <p><b>Nights:</b> <%= booking.nights %></p>
            <p><b>Total Price:</b> &#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></p>
            <form method="post" action="/bookings/<%= booking._id %>?_method=delete">
              <button class="btn btn-outline-danger" type="submit">Cancel Booking</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
