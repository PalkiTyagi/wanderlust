<% layout("/layouts/boilerplate") %>
    <%= success || "" %>

<body>
  <div class="category-bar">
    <div class="category-list">
      <div class="filters"><i class="fa-solid fa-fire"></i><span>Trending</span></div>
      <div class="filters"><i class="fa-solid fa-bed"></i><span>Rooms</span></div>
      <div class="filters"><i class="fa-solid fa-city"></i><span>Iconic Cities</span></div>
      <div class="filters"><i class="fa-solid fa-mountain"></i><span>Mountains</span></div>
      <div class="filters"><i class="fa-solid fa-chess-rook"></i><span>Castles</span></div>
      <div class="filters"><i class="fa-solid fa-person-swimming"></i><span>Amazing Pools</span></div>
      <div class="filters"><i class="fa-solid fa-campground"></i><span>Camping</span></div>
      <div class="filters"><i class="fa-solid fa-wheat-awn"></i><span>Farms</span></div>
      <div class="filters"><i class="fa-solid fa-snowflake"></i><span>Arctic</span></div>
      <div class="filters"><i class="fa-solid fa-igloo"></i><span>Domes</span></div>
      <div class="filters"><i class="fa-solid fa-sailboat"></i><span>Boats</span></div>
    </div>
    <label class="tax-toggle">
      <span>Display total after taxes</span>
      <input type="checkbox" aria-label="Display total after taxes">
      <span class="toggle-track"></span>
    </label>
  </div>

  <!-- Listings Section -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>
       
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img 
            src="<%= listing.image.url %>" 
            class="card-img-top" 
            alt="listing img" 
            style="height: 20rem;"
          >
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              &#8377; <%= Number(listing.price).toLocaleString("en-IN") %>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>
