
    
    <% layout("/layouts/boilerplate") %>
<%= success %>

<body>
  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
    }
    .filters {
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.8;
    }
    .filters:hover {
      opacity: 1;
    }
    .filters p {
      font-size: 0.9rem;
    }
  </style>

  <!-- Filters Section -->
  <div id="filters">
    <div class="filters">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>

    <div class="filters">
      <div><i class="fa-solid fa-bowl-food"></i></div>
      <p>Food Services</p>
    </div>

    <div class="filters">
      <div><i class="fa-solid fa-umbrella-beach"></i></div>
      <p>Beaches</p>
    </div>
  </div>

  <!-- Listings Section -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img 
            src="<%= listing.image.url %>" 
            class="card-img-top" 
            alt="listing img" 
            style="height: 20rem;"
          >
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              &#8377; <%= Number(listing.price).toLocaleString("en-IN") %>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>
