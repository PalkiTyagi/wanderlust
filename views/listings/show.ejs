<% layout("/layouts/boilerplate") %>
<main class="listing-show-page">
  <section class="listing-hero">
    <div>
      <p class="listing-kicker">Stay in <%= listing.country %></p>
      <h1><%= listing.title %></h1>
      <p class="listing-location"><i class="fa-solid fa-location-dot"></i> <%= listing.location %></p>
    </div>
    <div class="listing-owner">Hosted by <strong><%= listing.owner?.username || "Unknown Owner" %></strong></div>
  </section>

  <section class="listing-details-grid">
    <div class="listing-main-card">
      <img src="<%=listing.image.url %>" class="show-image" alt="<%= listing.title %>">
      <div class="listing-description">
        <h2>About this place</h2>
        <p><%= listing.description %></p>
        <p class="listing-price"><strong>&#8377; <%= listing.price.toLocaleString("en-IN") %></strong> <span>night</span></p>
      </div>
    </div>

    <aside class="listing-side-column">
      <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="owner-actions">
          <h3>Manage listing</h3>
          <div class="action-buttons">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit listing</a>
            <form method="post" action="/listings/<%= listing._id %>?_method=delete">
              <button class="btn btn-outline-danger" type="submit">Delete listing</button>
            </form>
          </div>
        </div>
      <% } %>

      <div class="booking-panel">
        <div class="booking-heading">
          <h2>Book this property</h2>
          <span>&#8377; <%= listing.price.toLocaleString("en-IN") %> / night</span>
        </div>
        <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
          <div class="owner-notice">You cannot book your own property.</div>
        <% } else { %>
          <form action="/bookings" method="post">
            <input type="hidden" name="listingId" value="<%= listing._id %>">
            <div class="booking-fields">
              <div>
                <label for="checkIn">Check in</label>
                <input type="date" name="checkIn" id="checkIn" required>
              </div>
              <div>
                <label for="checkOut">Check out</label>
                <input type="date" name="checkOut" id="checkOut" required>
              </div>
              <div>
                <label for="guests">Guests</label>
                <input type="number" name="guests" id="guests" min="1" value="1" required>
              </div>
            </div>
            <button class="btn book-button" type="submit">Book Now</button>
          </form>
        <% } %>
      </div>
    </aside>
  </section>
</main>
<hr class="section-divider">

 <section class="reviews-section mb-3">
 <% if (currUser) { %>
  <h4>leave a review</h4>
  <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
    
    <div class="mb-3 mt-3" >
    <label for="rating">rating</label>
    <div class="starability-slot">
    
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
    </div>

    <div mb-3 mt-3>
      <label for="comment" class="form-label">comments</label>
      <textarea name="review[comment]" cols="30" rows="5" id="comment" class="form-control" required></textarea>
      <div class="invalid-feedback"> please add some coments</div>
    </div>
    <br>
    <button class="btn btn-outline-dark">submitt</button>
    
  </form>
 <% } %>
  <p><b>all review</b></p> 
   
   
<div class="row reviews-grid">
  <% for (let review of listing.reviews) { %>
    <div class="card col-md-5 ms-3 mb-3 review-card">
        <div class="card-body">
          <h5 class="card-title"><%= review.author?.username || "Anonymous" %></h5>
          <p class="card-text "><%= review.comment %></p>
           <p class="starability-result card-text" data-rating="<%= review.rating %>">
  </p>
        </div>
        <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
          <form class="mb-3" method="post" action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=delete">
            <button class="btn btn-sm btn-dark ">delete</button>
          </form>
        <% } %>
      </div>
    
  <% } %>
</div>
<h3>Where you'll be</h3>

<div id="map"></div>
</section>

<script>
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  const title = "<%= listing.title %>";
</script>