<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
  <div class="col-8 offset-2">
    <h2>edit your listing!!</h2>
    <form method="post" action="/listings/<%= listing._id %>?_method=put" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="title" class="form-label">title</label>
    <input type="text" name=listing[title] value="<%= listing.title %>" class="form-control" required> 
    <div class="valid-feedback">Looks good!</div>
  </div>
    <br>
  

    <div class="mb-3">
      <label for="image" class="form-label">upload image</label>
    <input type="file" name=listing[image] value="<%= listing.image.url %>" class="form-control"> 
  </div>
  
    <br>

    <div class="mb-3">
      <label for="description" class="form-label">description</label>
     <textarea 
  name="listing[description]" 
  class="form-control"
  rows="3"
><%= listing.description %> required</textarea>
<div class="invalid-feedback"> add a description</div>
     </div>
    <br>
     
    <div class="row">
    <div class="mb-3 col-md-4">
      <label for="title" class="form-label">price</label>
    <input type="text" name=listing[price] value="<%= listing.price %>" class="form-control" required>
    <div class="invalid-feedback"> add a price</div> 
    </div>
    <div class="mb-3 col-md-8">
      <label for="title" class="form-label">country</label>
    <input type="text" name=listing[country] value="<%= listing.country %>" class="form-control" required>
    <div class="invalid-feedback"> add a country</div>
    </div> 
    </div>
   <br>

    <div class="mb-3">
      <label for="title" class="form-label">location</label>
    <input type="text" name=listing[location] value="<%= listing.location %>" class="form-control" required>
    <div class="invalid-feedback"> add a location</div>
    </div>
    <br>
      <button class="btn btn-dark edit-btn mt-3 ">edit</button>
      <br>
    </form>
    <br>
  </div>
  </div>
  
</body>
